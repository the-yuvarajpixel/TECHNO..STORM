# GEMINI_API_KEY: Optional (only required if enabling AI features later).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The hosted URL where Sentinel is deployed (must also be added to Firebase Authorized Domains).
APP_URL="MY_APP_URL"

# === Sentinel Regional Data Plane & Security Configuration ===
# SENTINEL_EDGE_SALT: Per-customer secret salt used at the edge to compute deterministic HMAC tokens for masked PII/secrets.
SENTINEL_EDGE_SALT="CHANGE_ME_32_BYTE_RANDOM_HEX_SALT"

# SENTINEL_REGION: Regional data-plane identifier (auto-derived from SENTINEL_BYOK_KEY_ID ARN if omitted).
SENTINEL_REGION="ap-southeast-2"

# SENTINEL_BYOK_KEY_ID: Customer-managed AWS KMS / Cloud KMS key ARN for regional data-plane envelope encryption.
SENTINEL_BYOK_KEY_ID="arn:aws:kms:ap-southeast-2:ACCOUNT_ID:key/YOUR_KEY_UUID"

# SENTINEL_STORAGE_PATH: Persistent storage path for local regional state (replace with managed DB / WORM bucket in enterprise prod).
SENTINEL_STORAGE_PATH="/tmp/sentinel-regional-ap-southeast-2-v4.json"

# SENTINEL_WEBHOOK_SIGNING_SECRET: Optional default HMAC-SHA256 signing secret for outbound Slack/PagerDuty/Teams webhooks.
SENTINEL_WEBHOOK_SIGNING_SECRET="CHANGE_ME_WEBHOOK_SIGNING_SECRET"

# VITE_API_BASE_URL: Leave empty for same-origin API (AI Studio, Node server, or Netlify Functions via netlify.toml).
# Only set this if hosting the static frontend separately from the Express API backend.
VITE_API_BASE_URL=""

